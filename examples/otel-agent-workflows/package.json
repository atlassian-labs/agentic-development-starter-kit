{
  "name": "otel-agent-workflows-example",
  "version": "0.1.0",
  "private": true,
  "description": "Vendor-neutral OpenTelemetry example for agentic workflow tracing and local performance diagnosis.",
  "main": "src/workflowRunner.js",
  "scripts": {
    "test": "jest --runInBand",
    "demo:happy": "node bin/run-workflow.js --mode happy --exporter console",
    "demo:bounce": "node bin/run-workflow.js --mode bounce --exporter console",
    "demo:error": "node bin/run-workflow.js --mode error --exporter console",
    "performance:nplus1": "node bin/run-performance-demo.js --mode nplus1 --exporter otlp",
    "performance:batch": "node bin/run-performance-demo.js --mode batch --exporter otlp",
    "diagnose:local": "node bin/run-local-diagnosis.js",
    "measure:overhead": "node bin/measure-workflow-overhead.js",
    "traces:summary": "node bin/summarize-jaeger.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.38.0"
  },
  "devDependencies": {
    "jest": "30.5.2"
  },
  "license": "MIT"
}
